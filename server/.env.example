# ========== 「装了吗」服务端配置模板 ==========
# 用法：复制一份改名为 .env，再按下面注释填写；改完重启服务生效
#   PowerShell: Copy-Item .env.example .env

# ---- AI（OpenAI 兼容 Chat Completions 接口）----
# 以 DeepSeek 为例：去 https://platform.deepseek.com 注册，在「API keys」页面创建
# ANTHROPIC_AUTH_TOKEN 填你的 Key（sk- 开头的一长串），不要提交到 git
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_ENABLED=true
AI_TIMEOUT=180
# 单次最大输出 tokens（DeepSeek deepseek-chat 上限 8000）
AI_MAX_TOKENS=8000

# ---- 管理后台 ----
# 上线前务必改成你自己的强密码；ADMIN_SECRET 用随机长字符串
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN_TTL=43200

# ---- 服务 ----
HOST=127.0.0.1
PORT=8017
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173
